# Agrega estas variables a tu .env (credenciales de PRUEBA, nunca reales)

# Postgres (administrador)
POSTGRES_DB=huellared
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Usuarios de Postgres que crea configurar.py
HUELLARED_APP_PASSWORD=postgres-app
HUELLARED_CONSULTA_PASSWORD=postgres-consulta
HUELLARED_ADMIN_PASSWORD=postgres-admin

# Web
SECRET_KEY=agrega-una-cadena-larga-aleatoria-aqui
COOKIE_SECURE=1
LOGIN_PASS_APP=demo-app
LOGIN_PASS_CONSULTA=demo-consulta
LOGIN_PASS_ADMIN=demo-admin